#!/usr/bin/env bash
#
# sandbox-run - lightweight bubblewrap wrapper for sandboxing dev tools
# Based on https://github.com/sandbox-utils/sandbox-run (AGPL-3.0)
# SPDX-License-Identifier: AGPL-3.0-or-later
#

set -o errexit
set -o nounset
set -o pipefail

yell() { echo "$0: $*" >&2; }
die() { yell "$*"; exit 111; }
usage() {
    cat <<'EOF'
Usage: sandbox-run [OPTIONS] <command> [args...]

Run a command inside a bubblewrap sandbox.

Options:
  -g, --git              Clone the current project git repository into a temporary directory
  -t, --tmpdir LOC       Parent directory for the temporary clone; requires --git
                         LOC may be 'auto' (under the source repo's .git/) or a path.
                         Overrides SANDBOX_RUN_GIT_TMPDIR.
  -h, --help             Show this help message and exit
EOF
}

# Parse colon-separated env var into array
parse_paths() {
    local var="$1"
    local -n arr="$2"
    [[ -z "${!var:-}" ]] && return
    IFS=':' read -ra paths <<< "${!var}"
    arr+=("${paths[@]}")
}

# Boolean check
is_enabled() {
    [[ "${!1:-0}" == "1" ]]
}

if is_enabled SANDBOX_RUN_TRACE; then
    set -o xtrace
fi

# Cleanup function for background processes and temp files
CLEANUP_PIDS=()
CLEANUP_FILES=()
cleanup() {
    for pid in "${CLEANUP_PIDS[@]}"; do
        kill "$pid" 2>/dev/null || true
    done
    # Wait for processes to actually terminate before removing their files
    for pid in "${CLEANUP_PIDS[@]}"; do
        wait "$pid" 2>/dev/null || true
    done
    for f in "${CLEANUP_FILES[@]}"; do
        rm -rf "$f" 2>/dev/null || true
    done
}
trap cleanup EXIT

ORIGINAL_ARGS=("$@")
SCRIPT_NAME="${0##*/}"
USE_GIT_CLONE=0
GIT_TMPDIR_CLI=""

# Prevent nested sandboxing (causes overhead and bind-mount conflicts)
if [[ -n "${SANDBOX_RUN:-}" ]]; then
    yell "warning: already sandboxed, executing directly"
    exec "${ORIGINAL_ARGS[@]}"
fi


if ! command -v bwrap > /dev/null 2>&1
then
  die "Please install bubblewrap!"
fi

# Determine command to run:
# - Symlink mode (e.g., ~/bin/claude -> sandbox-run): use symlink name
# - Direct mode (e.g., sandbox-run claude): use first argument
# The sandbox's PATH will resolve it (includes ~/.local/bin + system paths)
if [ "$SCRIPT_NAME" = 'sandbox-run' ]; then
    while [ $# -gt 0 ]; do
        case "$1" in
            -h|--help)
                usage
                exit 0
                ;;
            -g|--git)
                USE_GIT_CLONE=1
                shift
                ;;
            -t|--tmpdir|--tmpdir=*)
                case "$1" in
                    --tmpdir=*)
                        GIT_TMPDIR_CLI="${1#--tmpdir=}"
                        [ -n "$GIT_TMPDIR_CLI" ] || die "--tmpdir= requires a value"
                        shift
                        ;;
                    *)
                        [ $# -lt 2 ] && die "Option '$1' requires an argument"
                        GIT_TMPDIR_CLI="$2"
                        shift 2
                        ;;
                esac
                ;;
            --)
                shift
                break
                ;;
            -*)
                break
                ;;
            *)
                break
                ;;
        esac
    done

    if [ -n "$GIT_TMPDIR_CLI" ] && [ "$USE_GIT_CLONE" -eq 0 ]; then
        die "--tmpdir requires --git"
    fi

    # CLI --tmpdir overrides SANDBOX_RUN_GIT_TMPDIR
    if [ -n "$GIT_TMPDIR_CLI" ]; then
        SANDBOX_RUN_GIT_TMPDIR="$GIT_TMPDIR_CLI"
    fi

    if [ $# -eq 0 ]; then
        if [ -n "${SANDBOX_RUN_DEFAULT_CMD:-}" ]; then
            read -ra _default_cmd <<< "$SANDBOX_RUN_DEFAULT_CMD"
            set -- "${_default_cmd[@]}"
        else
            usage >&2
            exit 1
        fi
    fi
    bin="$1"
    shift
else
    bin="$SCRIPT_NAME"
fi

PROJECT_DIR="$(pwd)"
ORIGINAL_PROJECT_DIR="$PROJECT_DIR"
PROJECT_HASH=$(echo "$PROJECT_DIR" | sha256sum | cut -c1-12)
UID_NUM=$(id -u)

if [ "$USE_GIT_CLONE" -eq 1 ]; then
    if ! command -v git > /dev/null 2>&1; then
        die "--git requested but git is not installed"
    fi
    if ! git -C "$ORIGINAL_PROJECT_DIR" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
        yell "warning: --git requested but $ORIGINAL_PROJECT_DIR is not inside a git repository; continuing without cloning"
    else
        repo_root=$(git -C "$ORIGINAL_PROJECT_DIR" rev-parse --show-toplevel)
        rel_path="${ORIGINAL_PROJECT_DIR#$repo_root}"
        if [ "$rel_path" = "$ORIGINAL_PROJECT_DIR" ]; then
            rel_path=""
        else
            rel_path="${rel_path#/}"
        fi

        current_branch=$(git -C "$ORIGINAL_PROJECT_DIR" rev-parse --abbrev-ref HEAD 2>/dev/null || true)

        # Pick a parent directory for the temporary clone.
        # SANDBOX_RUN_GIT_TMPDIR:
        #   unset   -> default mktemp location ($TMPDIR or /tmp)
        #   auto    -> a directory under the source repo's .git/, which is
        #              guaranteed to live on the same filesystem as the
        #              source object store. This lets git's local-clone
        #              hardlink optimization kick in (much faster and far
        #              cheaper on disk for large repositories).
        #   <path>  -> explicit path (relative to CWD or absolute); must exist.
        clone_parent=""
        case "${SANDBOX_RUN_GIT_TMPDIR:-}" in
            "")
                ;;
            auto)
                git_common=$(git -C "$ORIGINAL_PROJECT_DIR" rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)
                if [ -z "$git_common" ]; then
                    yell "warning: SANDBOX_RUN_GIT_TMPDIR=auto: cannot determine git common dir; falling back to default mktemp"
                else
                    clone_parent="$git_common/sandbox-run-clones"
                    if ! mkdir -p "$clone_parent" 2>/dev/null; then
                        yell "warning: SANDBOX_RUN_GIT_TMPDIR=auto: cannot create $clone_parent; falling back to default mktemp"
                        clone_parent=""
                    fi
                fi
                ;;
            *)
                clone_parent="$SANDBOX_RUN_GIT_TMPDIR"
                [ -d "$clone_parent" ] || die "SANDBOX_RUN_GIT_TMPDIR='$SANDBOX_RUN_GIT_TMPDIR' is not a directory"
                ;;
        esac

        if [ -z "$clone_parent" ]; then
            clone_dir=$(mktemp -d -t sandbox-run.git.XXXXXX)
        else
            clone_dir=$(mktemp -d -p "$clone_parent" sandbox-run.git.XXXXXX)
        fi
        [ -d "$clone_dir" ] || die "Failed to create temporary directory for git clone"
        CLEANUP_FILES+=("$clone_dir")

        clone_opts=(--origin human)
        if [ -n "$current_branch" ] && [ "$current_branch" != "HEAD" ]; then
            clone_opts+=(--single-branch --branch "$current_branch")
        fi

        git clone "${clone_opts[@]}" "$repo_root" "$clone_dir"

        (
            set -euo pipefail
            cd "$clone_dir"
            git remote set-url --push human DISABLED
            if [ -n "$current_branch" ] && [ "$current_branch" != "HEAD" ]; then
                git checkout "$current_branch" >/dev/null 2>&1
            else
                head_commit=$(git -C "$ORIGINAL_PROJECT_DIR" rev-parse HEAD)
                git checkout --detach "$head_commit"
                git branch --force sandbox-detached "$head_commit" >/dev/null 2>&1
                git checkout sandbox-detached >/dev/null 2>&1
            fi
        )

        if [ -n "$rel_path" ]; then
            PROJECT_DIR="$clone_dir/$rel_path"
        else
            PROJECT_DIR="$clone_dir"
        fi

        if [ ! -d "$PROJECT_DIR" ]; then
            die "Cloned repository missing expected path '${rel_path:-.}'"
        fi

        yell "Using git sandbox clone at $PROJECT_DIR (remote human=$repo_root)"
    fi
fi

# Base sandbox directories
SANDBOX_ROOT="$HOME/.sandbox-run"
SANDBOX_CACHE="$SANDBOX_ROOT/cache"
SANDBOX_LOCAL="$SANDBOX_ROOT/local"

# Ensure base directories exist
mkdir -p "$SANDBOX_CACHE" "$SANDBOX_LOCAL"

###############################################################################
# CONFIGURATION
# Customize these arrays to control what's available inside the sandbox
###############################################################################

# Namespace isolation options
ISOLATION_OPTS=(
    --unshare-all
    # Alternative: individual unshare options instead of --unshare-all
    # --unshare-pid
    # --unshare-ipc
    # --unshare-uts
    # --unshare-user
    # --unshare-cgroup
)

# Network isolation
if is_enabled SANDBOX_RUN_NO_NET; then
    NET_OPTS=(--unshare-net)
    yell "Network access disabled (SANDBOX_RUN_NO_NET=1)"
else
    NET_OPTS=(--share-net)
fi

# System binds (read-only, using --ro-bind-try so missing paths don't cause errors)
RO_BINDS=(
    /usr
    /lib
    /lib64
    /bin
    /opt
    # /sbin  # uncomment if tools like ip, iptables etc. are needed
    /etc/alternatives
    /etc/ca-certificates
    /etc/crypto-policies
    /etc/resolv.conf
    /etc/hosts
    /etc/ssl
    /etc/pki
    /etc/localtime
    /etc/timezone
    /etc/os-release
    /etc/xml/
    /var/lib/ca-certificates
    # needed for dpkg-shlibdeps etc. when building Debian packages
    /etc/dpkg/
    /var/lib/dpkg
    # NOTE: /etc/passwd and /etc/group are NOT bound here.
    # Instead, we create synthetic minimal versions via --bind-data at the end
    # of the bwrap call. This avoids leaking info about all users/groups on the
    # host system. The synthetic files contain only:
    #   - passwd: current user + nobody (65534) as fallback
    #   - group: user's primary group + nobody + common desktop groups
    # The heredocs (5<<EOF, 4<<EOF2) pipe 'getent' output to file descriptors
    # that bwrap mounts as /etc/passwd and /etc/group.
)

# Dynamic arrays populated by presets
RW_BINDS=()
DEV_BINDS=()
SANDBOX_BINDS=()
SHARED_BINDS=()
EXTRA_BWRAP_OPTS=()
SANDBOX_RUN_FINALIZERS=()

# Flags that presets can modify
DISABLE_NEW_SESSION=0  # Set to 1 to allow job control (needed for job management)

# Files to block (bind /dev/null over them)
# Commented entries are examples; uncomment or add paths as needed for your setup
BLOCKED=(
    #"$PROJECT_DIR/.env"
    #"$PROJECT_DIR/.env.local"
    "$PROJECT_DIR/.env.production"
)

###############################################################################
# LOAD PRESETS
###############################################################################

# Resolve the directory where the sandbox-run script lives (follows symlinks)
SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"

# Source preset files from:
# 1. Built-in presets shipped alongside the script (presets.d/)
# 2. User-defined presets in ~/.sandbox-run/presets.d/
# Filename (without .sh) becomes the preset name: my-tool.sh -> configure_my_tool
# To add custom presets, copy a .sh file from presets.d/ to ~/.sandbox-run/presets.d/
# or create a new one. Example: ~/.sandbox-run/presets.d/my-app.sh
#   configure_my_app() {
#       RO_BINDS+=("/path/to/my-app/readonly")
#       RW_BINDS+=("/path/to/my-app/writable")
#   }
# Then enable per-project: SANDBOX_RUN_PRESETS_EXTRA=my-app
for _preset_dir in "$SCRIPT_DIR/presets.d" "$SANDBOX_ROOT/presets.d"; do
    if [[ -d "$_preset_dir" ]]; then
        for preset_file in "$_preset_dir"/*.sh; do
            [[ -f "$preset_file" ]] && source "$preset_file"
        done
    fi
done
unset _preset_dir

# Default presets (user presets require explicit SANDBOX_RUN_PRESETS_EXTRA)
PRESETS=(npm python go cargo dbus)

# Extra presets: opt-in via SANDBOX_RUN_PRESETS_EXTRA=claude:pi:wayland:audio
# AI tools: claude, opencode, pi, vibe
# VCS tools: git, glab, forgejo
# Other: audio, docker, tmux, wayland
PRESETS_EXTRA=()

# Override defaults with SANDBOX_RUN_PRESETS=claude:npm:go (empty = load nothing)
if [[ -n "${SANDBOX_RUN_PRESETS+set}" ]]; then
    if [[ -n "$SANDBOX_RUN_PRESETS" ]]; then
        IFS=':' read -ra PRESETS <<< "$SANDBOX_RUN_PRESETS"
    else
        PRESETS=()
    fi
fi

# Add extra presets with SANDBOX_RUN_PRESETS_EXTRA=wayland
if [[ -n "${SANDBOX_RUN_PRESETS_EXTRA:-}" ]]; then
    IFS=':' read -ra PRESETS_EXTRA <<< "$SANDBOX_RUN_PRESETS_EXTRA"
fi

# Combine default and extra presets
PRESETS+=("${PRESETS_EXTRA[@]}")

# Arrays populated by presets
ENV_PRESET_OPTS=()
PATH_ADDITIONS=("$HOME/.local/bin")  # Base path, presets may add more
LOADED_PRESETS=()

for preset in "${PRESETS[@]}"; do
    fn="configure_$preset"
    if declare -f "$fn" > /dev/null; then
        "$fn"
        LOADED_PRESETS+=("$preset")
    else
        # Warn about missing presets only when using explicit override (catches typos)
        [[ -n "${SANDBOX_RUN_PRESETS:-}" ]] && yell "Warning: Preset function '$fn' not found"
    fi
done

# Print loaded presets
if [[ ${#LOADED_PRESETS[@]} -gt 0 ]]; then
    yell "Presets: ${LOADED_PRESETS[*]}"
fi

# Build PATH from preset additions (duplicates are harmless)
if [[ ${#PATH_ADDITIONS[@]} -gt 0 ]]; then
    PRESET_PATH=$(printf '%s:' "${PATH_ADDITIONS[@]}" | tr -s ':' | sed 's/:$//')
    ENV_PRESET_OPTS+=(--setenv PATH "$PRESET_PATH:$PATH")
fi

# Append paths from environment variables
parse_paths SANDBOX_RUN_RO_BIND RO_BINDS
parse_paths SANDBOX_RUN_RW_BIND RW_BINDS
parse_paths SANDBOX_RUN_DEV_BIND DEV_BINDS
parse_paths SANDBOX_RUN_BLOCKED BLOCKED

# Let presets do any setup that depends on all presets having run.
for finalizer in "${SANDBOX_RUN_FINALIZERS[@]}"; do
    if declare -f "$finalizer" >/dev/null; then
        "$finalizer"
    else
        yell "Warning: finalizer function '$finalizer' not found"
    fi
done

###############################################################################
# END CONFIGURATION
###############################################################################


# Build bwrap bind options (using -try variants so missing paths don't cause errors)
BIND_OPTS=()
# Base binds: sandbox local as ~/.local (tools default to ~/.local paths)
BIND_OPTS+=(--bind "$SANDBOX_LOCAL" "$HOME/.local")
BIND_OPTS+=(--bind "$SANDBOX_CACHE" "$SANDBOX_CACHE")
for p in "${RO_BINDS[@]}"; do BIND_OPTS+=(--ro-bind-try "$p" "$p"); done
for p in "${RW_BINDS[@]}"; do BIND_OPTS+=(--bind-try "$p" "$p"); done
# Device binds must be applied after bwrap creates its private /dev below.
# Resolve sources first: udev aliases are symlinks whose targets would otherwise
# be looked up in the private /dev, where devices such as ttyUSB0 do not exist.
# Keep the original path as the destination so the alias remains usable inside.
DEV_BIND_OPTS=()
for p in "${DEV_BINDS[@]}"; do
    src=$(readlink -f -- "$p" 2>/dev/null) || src="$p"
    DEV_BIND_OPTS+=(--dev-bind "$src" "$p")
done
# Sandbox dirs first (source:dest format)
for entry in "${SANDBOX_BINDS[@]}"; do
    src="${entry%%:*}"
    dst="${entry##*:}"
    BIND_OPTS+=(--bind "$src" "$dst")
done
# Shared items overlaid on top of sandbox
for p in "${SHARED_BINDS[@]}"; do BIND_OPTS+=(--bind-try "$p" "$p"); done
for p in "${BLOCKED[@]}"; do
    if [[ -e "$p" ]]; then
        if [ -d "$p" ]; then
            tmp_dir="$(mktemp -d || true)"
            [ -d "$tmp_dir" ] || die "Could not create temp dir to shadow $p"
            CLEANUP_FILES+=("$tmp_dir")
            BIND_OPTS+=(--ro-bind "$tmp_dir" "$p")
        else
            BIND_OPTS+=(--ro-bind /dev/null "$p")
        fi
    fi
done

# Environment variables to pass into sandbox
ENV_OPTS=(
    --setenv SANDBOX_RUN 1
    --setenv XDG_RUNTIME_DIR "/run/user/$UID_NUM"
    "${ENV_PRESET_OPTS[@]}"
)

# Prepare --unsetenv arguments to remove any current SANDBOX_RUN_* variables
while IFS= read -r name; do
    ENV_OPTS+=( --unsetenv "$name" )
done < <(compgen -e | grep '^SANDBOX_RUN_')

# Session isolation (default: enabled for security)
# Skip --new-session when attached to an interactive TTY so shells retain job control.
# This is insecure before Linux 6.2 (83efeeeb3d04b22aaed1df99bc70a48fe9d22c4d,
# cf. https://github.com/containers/bubblewrap/issues/142)
SESSION_OPTS=()
if [[ "$DISABLE_NEW_SESSION" -eq 0 ]]; then
    if [[ -t 0 && -t 1 ]]; then
        yell "TTY detected; preserving job control (no --new-session)"
    else
        SESSION_OPTS+=(--new-session)
    fi
fi

bwrap \
     --tmpfs /tmp \
     --tmpfs /run \
     --tmpfs /var \
     --symlink /run /var/run \
     --symlink /tmp /var/tmp \
     --dir "/run/user/$UID_NUM" \
     --bind "$PROJECT_DIR" "$PROJECT_DIR" \
     "${BIND_OPTS[@]}" \
     ${SANDBOX_RUN_BWRAP_ARGS:-} \
     "${EXTRA_BWRAP_OPTS[@]}" \
     --proc /proc \
     --dev /dev \
     "${DEV_BIND_OPTS[@]}" \
     "${ISOLATION_OPTS[@]}" \
     "${NET_OPTS[@]}" \
     "${ENV_OPTS[@]}" \
     --hostname sandbox-run \
     "${SESSION_OPTS[@]}" \
     --die-with-parent \
     --chdir "${SANDBOX_RUN_BWRAP_CHDIR:-$PROJECT_DIR}" \
     --bind-data 5 /etc/passwd \
     --bind-data 4 /etc/group \
     -- "$bin" "$@" \
     5<<EOF 4<<EOF2
$(getent passwd "$UID_NUM" 65534)
EOF
$(getent group "$(id -g)" 65534 adm sudo audio dip video plugdev staff users netdev)
EOF2
